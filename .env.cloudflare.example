# Copie este archivo como .env.cloudflare (no se sube a git) y complete los datos.
# Correos que pueden ver y editar los datos de la empresa, separados por coma.
VOLIA_ALLOWED_EMAILS=
# Se llenan después de activar Cloudflare Access en el worker (Settings → Domains & Routes → workers.dev).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Lo completa el script la primera vez que crea la base.
VOLIA_D1_DATABASE_ID=
VOLIA_D1_DATABASE_NAME=volia-control-db
